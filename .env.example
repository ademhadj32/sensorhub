# Configuration SensorHub
PORT=3001
NODE_ENV=development

# Sécurité & Authentification
JWT_SECRET=sensorhub_jwt_super_secret_key_change_in_production_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Clé API par défaut pour l'ESP32
DEFAULT_API_KEY=esp32-secret-key-123456

# Délai après lequel un ESP32 est considéré comme hors ligne (en secondes)
DEVICE_OFFLINE_THRESHOLD_SECONDS=30

# Port du Broker MQTT (défaut 1883)
MQTT_PORT=1883
